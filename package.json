{
  "name": "langgraph-lab",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.3",
      "@elysiajs/cors": "^1.4.2",
      "@elysiajs/eden": "^1.4.9",
      "elysia": "^1.4.0",
      "oxfmt": "^0.65.0",
      "oxlint": "^1.88.0",
      "@langchain/core": "^1.2.18",
      "@langchain/langgraph": "^1.5.1",
      "@langchain/openai": "^1.6.2",
      "langchain": "^1.5.18",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/node": "^24.19.2",
      "zod": "^3.25.76",
      "@commitlint/cli": "^21.2.2",
      "@commitlint/config-conventional": "^21.2.2",
      "husky": "^9.1.7",
      "lint-staged": "^17.6.0",
      "commitizen": "^4.3.2",
      "cz-git": "^1.14.0",
      "czg": "^1.14.0",
      "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
      "zustand": "^5.0.15",
      "immer": "^11.1.21",
      "repomix": "^1.18.1"
    }
  },
  "type": "module",
  "scripts": {
    "commit": "git-cz",
    "commit:ai": "czg ai",
    "dev": "bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun --env-file apps/backend/.env --watch apps/backend/src/index.ts",
    "dev:frontend": "bun run --filter '@lg-lab/frontend' dev",
    "fmt": "oxfmt --write",
    "lint": "bun run --filter './apps/*' --filter './packages/*' lint",
    "prepare": "husky",
    "repomix": "repomix --include 'apps/backend/src/**,apps/backend/package.json,packages/types/src/**' ",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "commitizen": "catalog:",
    "cz-git": "catalog:",
    "czg": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "repomix": "catalog:",
    "typescript": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
