{
  "//": [
    "registry vendor 台账：vendor 层所有文件的唯一事实来源。",
    "vendorRoots 下的每个文件都必须在此登记 —— 未登记即 check:vendor 失败，要么登记，要么搬出 vendor 层。",
    "target 是 registry item 声明的期望路径（@components/@ui/@lib/@hooks 分别映射到 src/components、src/components/ui、src/lib、src/hooks）。",
    "fork: true 表示该文件已刻意偏离 registry 路径（放弃该项的 CLI 升级能力），跳过路径一致性校验。",
    "改动后执行：bun run check:vendor"
  ],
  "vendorRoots": ["src/components/motion", "src/components/ui", "src/lib"],
  "firstPartyFiles": ["src/components/motion/index.ts"],
  "allowDuplicateExports": [
    {
      "name": "Route",
      "reason": "TanStack Router 的文件路由约定：每个路由文件必须导出 Route，属于框架强制约定而非重复实现"
    },
    {
      "name": "SignUpStatus",
      "reason": "TODO login-form.tsx 目前是 signup-form.tsx 的逐行副本（仅改了一个函数名），待重写为真正的登录表单后应删除这些豁免"
    },
    { "name": "SignUpValues", "reason": "TODO 同上，login-form.tsx 是 signup-form.tsx 的副本" },
    { "name": "SignUpErrors", "reason": "TODO 同上，login-form.tsx 是 signup-form.tsx 的副本" },
    {
      "name": "SignUpFormClassNames",
      "reason": "TODO 同上，login-form.tsx 是 signup-form.tsx 的副本"
    },
    { "name": "SignUpFormProps", "reason": "TODO 同上，login-form.tsx 是 signup-form.tsx 的副本" },
    { "name": "passwordStrength", "reason": "TODO 同上，login-form.tsx 是 signup-form.tsx 的副本" }
  ],
